        memzero v0 v1;
        return;
}


object @BalanceMap {
    section init {
        entry %manual_contract_init_root_BalanceMap;
        embed .runtime as &__BalanceMap_runtime;
    }
    section runtime {
        entry %manual_contract_runtime_root_BalanceMap;
    }
}
