use core::{Option, Result}
use std::native::{Args, FixedStack, ByteBuffer}
struct Frame { value: u64, words: [u256; 4], memory: ByteBuffer }

pub fn main(argc: i32, argv: **u8) -> i32 {
    core::assert(core::size_of<[Option<Frame>; 3]>() == 558)
    let args = unsafe { Args::new(argc, argv) }
    let mode = if args.len() == 1 { 0 } else { args.get(1).byte_at(0) - 48 }
    var stack: FixedStack<Frame, 3> = match FixedStack::try_new() {
        Option::Some(stack) => stack,
        Option::None => {
            core::assert(mode == 1)
            return 0
        },
    }
    core::assert(mode != 1)
    var count: u64 = 0
    var failed = false
    while count < 4 {
        var memory = ByteBuffer::new()
        if !memory.try_resize(8192) {
            memory.release()
            failed = true
            break
        }
        memory.set_byte(index: 8191, value: (count + 41).downcast_unchecked())
        let frame = Frame { value: count, words: [count as u256; 4], memory }
        match stack.try_push(frame) {
            Result::Ok(()) => {
                core::assert(count < 3)
                count += 1
            },
            Result::Err(frame) => {
                core::assert(count == 3 && stack.len() == 3)
                core::assert(frame.value == 3 && frame.words[3] == 3)
                core::assert(frame.memory.byte_at(8191) == 44)
                frame.memory.release()
                break
            },
        }
    }
    while stack.len() > 0 {
        count -= 1
        let frame = stack.top_mut()
        core::assert(frame.value == count)
        core::assert(frame.words[3] == count as u256)
        core::assert(frame.memory.byte_at(8191) == (count + 41).downcast_unchecked())
        frame.memory.set_byte(index: 0, value: 97)
        let frame = stack.pop()
        core::assert(frame.value == count && frame.memory.byte_at(0) == 97)
        frame.memory.release()
    }
    core::assert(count == 0 && failed == (mode == 2))
    stack.release()
    var empty: FixedStack<ByteBuffer, 0> = match FixedStack::try_new() {
        Option::Some(stack) => stack,
        Option::None => core::panic(),
    }
    core::assert(empty.len() == 0)
    match empty.try_push(ByteBuffer::new()) {
        Result::Err(buffer) => buffer.release(),
        Result::Ok(()) => core::panic(),
    }
    empty.release()
    0
}
