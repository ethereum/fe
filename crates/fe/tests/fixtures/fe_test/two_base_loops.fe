// A two-base driver traverses two bases the loop holds in step:
// `for (x, y) in (a, b) by zip()` views both, and `(mut a, mut b)` mutates
// both, which needs the bases disjoint.
use core::iter::zip

struct Item { n: u256 }

fn dot(_ a: [u256; 3], _ b: [u256; 3]) -> u256 {
    var s = 0
    for (x, y) in (a, b) by zip() {
        s += x * y
    }
    s
}

struct Pair { a: [u256; 2], b: [u256; 2] }

#[test]
fn zips() {
    assert!(dot([1, 2, 3], [4, 5, 6]) == 32)

    // The shorter base ends the loop.
    let short: [u256; 2] = [1, 1]
    let long: [u256; 3] = [5, 6, 7]
    var n = 0
    for (x, y) in (short, long) by zip() {
        n += x + y
    }
    assert!(n == 13)

    // Non-`Copy` elements are viewed.
    let items = [Item { n: 1 }, Item { n: 2 }]
    let weights = [Item { n: 10 }, Item { n: 20 }]
    var total = 0
    for (ref i, ref w) in (items, weights) by zip() {
        total += i.n * w.n
    }
    assert!(total == 50)

    // Disjoint fields of one owner are mutated together.
    var p = Pair { a: [1, 2], b: [3, 4] }
    for (mut x, mut y) in (p.a, p.b) by zip() {
        x += 10
        y += x
    }
    assert!(p.a[1] == 12 && p.b[1] == 16)
}
