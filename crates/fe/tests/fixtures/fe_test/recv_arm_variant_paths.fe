msg M {
    #[selector = 0x01]
    V { n: u256 } -> u256,
    #[selector = 0x02]
    U -> u256,
}

// An arm names its variant by its bare name in a named recv block, or by a
// path resolved where the arm is written.
pub contract Named {
    recv M {
        M::V { n } -> u256 {
            n + 1
        }
        M::U -> u256 {
            7
        }
    }
}

pub contract Bare {
    recv {
        M::V { n } -> u256 {
            n + 2
        }
        M::U -> u256 {
            8
        }
    }
}

#[test]
fn test_recv_arm_variant_paths() uses (evm: mut Evm) {
    let named = evm.create2<Named>(value: Wei::zero(), args: (), salt: 0)
    let bare = evm.create2<Bare>(value: Wei::zero(), args: (), salt: 0)

    assert(evm.call(addr: named, gas: 100000, value: Wei::zero(), message: M::V { n: 1 }) == 2)
    assert(evm.call(addr: named, gas: 100000, value: Wei::zero(), message: M::U {}) == 7)
    assert(evm.call(addr: bare, gas: 100000, value: Wei::zero(), message: M::V { n: 1 }) == 3)
    assert(evm.call(addr: bare, gas: 100000, value: Wei::zero(), message: M::U {}) == 8)
}
