// By-value traversal holds no access on its base between steps, so the body
// may change the collection, and `at` reads each element afresh. A session a
// loop condition opens closes before the back edge.
use core::iter::Collection

#[test]
fn by_value_traversal_mutates_its_base() {
    var xs: [u256; 3] = [1, 2, 3]
    var total: u256 = 0
    for x in xs {
        xs[2] = 10
        total += x
    }
    assert(total == 1 + 2 + 10)

    var list: MemArray<u256> = MemArray::new_zeroed(3)
    for x in list {
        list.set(2, x + 5)
    }
    assert(list[2] == 10)
}

#[test]
fn while_let_sessions_close_each_step() {
    var xs: MemArray<u256> = MemArray::new_zeroed(3)
    var i: usize = 0
    while let Option::Some(x) = xs.get_mut(i) {
        x += i as u256 + 1
        i += 1
    }
    assert(xs[0] == 1 && xs[1] == 2 && xs[2] == 3)
}
