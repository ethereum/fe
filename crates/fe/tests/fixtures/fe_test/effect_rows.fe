// Associated effect rows: a trait declares a row, each implementation
// gives its effects, and functions name rows in their `uses` clauses.

trait Counter {
    uses E
    fn bump(mut self) uses E

    fn bump_twice(mut self) uses E {
        self.bump()
        self.bump()
    }
}

struct Store { total: u256 }
struct Log { entries: u256 }

// An implementation whose row is a storage-like resource.
struct StoreCounter {}

impl Counter for StoreCounter {
    uses E = (store: mut Store)

    fn bump(mut self) uses E {
        store.total += 1
    }
}

// An implementation that omits its row: the row is empty.
struct MemCounter { n: u256 }

impl Counter for MemCounter {
    fn bump(mut self) uses E {
        self.n += 1
    }
}

// A generic implementation whose row contains another row.
struct Logged<C> { inner: C }

impl<C: Counter> Counter for Logged<C> {
    uses E = (C::E, log: mut Log)

    fn bump(mut self) uses E {
        self.inner.bump()
        log.entries += 1
    }
}

// An abstract row is forwarded by the caller's own.
fn bump_n<C: Counter>(_ c: mut C, _ n: u256) uses C::E {
    let mut i = 0
    while i < n {
        c.bump()
        i += 1
    }
}

// A row unions with the function's own effects.
fn bump_and_read<C: Counter>(_ c: mut C) -> u256 uses (C::E, store: Store) {
    c.bump()
    store.total
}

// A row expanded only in part: the inner `C::E` is forwarded, `Log`
// resolved here.
fn bump_logged<C: Counter>(_ x: mut Logged<C>) uses (C::E, log: mut Log) {
    x.bump()
}

#[test]
fn concrete_rows_take_providers_in_scope() {
    let mut store = Store { total: 0 }
    let mut sc = StoreCounter {}
    with (Store = store) {
        bump_n(mut sc, 3)
        sc.bump_twice()
        assert!(bump_and_read(mut sc) == 6)
    }
    assert!(store.total == 6)
}

#[test]
fn empty_rows_need_no_providers() {
    let mut mc = MemCounter { n: 0 }
    bump_n(mut mc, 2)
    mc.bump_twice()
    assert!(mc.n == 4)
}

#[test]
fn nested_rows() {
    let mut store = Store { total: 0 }
    let mut log = Log { entries: 0 }
    let mut stored = Logged { inner: StoreCounter {} }
    let mut plain = Logged { inner: MemCounter { n: 0 } }
    with (Store = store, Log = log) {
        bump_n(mut stored, 2)
        stored.bump_twice()
        bump_logged(mut stored)
        bump_logged(mut plain)
    }
    assert!(store.total == 5)
    assert!(log.entries == 6)
    assert!(plain.inner.n == 1)
}
