// A method call whose receiver's type is known only later in the body
// resolves then, but takes its effects where it is written: from the `with`
// blocks over it and, in a closure's body, from the closure's row.
struct Log {
    n: u256,
}

struct W<T> {
    v: T,
}

trait Note {
    fn note(self) -> u256 uses (log: Log)
    fn bump(self) uses (log: mut Log)
}

impl Note for W<u256> {
    fn note(self) -> u256 uses (log: Log) {
        log.n + self.v
    }

    fn bump(self) uses (log: mut Log) {
        log.n += self.v
    }
}

impl Note for W<u8> {
    fn note(self) -> u256 uses (log: Log) {
        0
    }

    fn bump(self) uses (log: mut Log) {}
}

fn in_with() -> u256 {
    with (Log = Log { n: 1 }) {
        let x = 5
        let r = W { v: x }.note()
        let y: u256 = x
        r
    }
}

fn in_closure() -> u256 uses (log: Log) {
    let g = || {
        let x = 5
        let r = W { v: x }.note()
        let y: u256 = x
        r
    }
    g()
}

fn in_nested_closure() -> u256 uses (log: Log) {
    let g = || {
        let h = || {
            let x = 5
            let r = W { v: x }.note()
            let y: u256 = x
            r
        }
        h()
    }
    g()
}

fn with_in_closure() -> u256 {
    let g = || {
        with (Log = Log { n: 1 }) {
            let x = 5
            let r = W { v: x }.note()
            let y: u256 = x
            r
        }
    }
    g()
}

fn bump_in_closure() uses (log: mut Log) {
    let g = || {
        let x = 5
        W { v: x }.bump()
        let y: u256 = x
    }
    g()
}

#[test]
fn deferred_calls_take_their_call_sites_effects() {
    assert!(in_with() == 6)
    assert!(with_in_closure() == 6)
    var log = Log { n: 2 }
    with (Log = log) {
        assert!(in_closure() == 7)
        assert!(in_nested_closure() == 7)
        bump_in_closure()
    }
    assert!(log.n == 7)
}
