use std::evm::{Evm, StorageMap, TStorPtr}

// A map's entries are persistent wherever the map lies. Storage and
// transient fields share one slot numbering, so a map inside transient state
// derives its entries from a slot no persistent field takes.

struct Ledger {
    balances: StorageMap<u256, u256>,
}

impl Ledger {
    fn get(self, _ key: u256) -> u256 {
        self.balances.get(key)
    }
}

msg Msg {
    #[selector = 1]
    Run -> u256,
}

pub contract C {
    mut a: StorageMap<u256, u256>,
    mut t: TStorPtr<Ledger>,

    recv Msg {
        Run -> u256 uses (mut a, mut t) {
            a.set(key: 1, value: 5)
            t.get(1)
        }
    }
}

#[test]
fn maps_in_transient_fields_have_their_own_entries() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    let v: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Run {})
    assert!(v == 0)
}
