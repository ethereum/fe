// Storage collections are `Collection`s and `Bidirectional`: a loop reads
// each element into the session, and a `mut` loop writes it back. A `Copy`
// element is copied before the body runs, so its session, which reserves
// storage, is finished and the body may write storage.
use std::evm::{Evm, RawStorage, SolArray, SolEnumerableSet}

#[test]
fn sol_array_loops() uses (evm: mut Evm) {
    with (RawStorage = evm) {
        let mut a = unsafe { SolArray<u256>::at(0) }
        a.push(1)
        a.push(2)
        a.push(3)

        let doubled = unsafe { SolArray<u256>::at(1) }
        for x in a {
            doubled.push(x * 2)
        }
        assert(doubled.len() == 3 && doubled.get(2) == 6)

        for x in mut a {
            x *= 10
        }
        assert(a.get(0) == 10 && a.get(1) == 20 && a.get(2) == 30)

        let mut weighted = 0
        for (i, x) in a.enumerate() {
            weighted += i as u256 * x
        }
        assert(weighted == 80)

        let mut tail = 0
        for x in a by core::iter::skip(1) {
            tail += x
        }
        assert(tail == 50)

        let mut digits = 0
        for x in a.reversed() {
            digits = digits * 100 + x
        }
        assert(digits == 302010)

        let empty = unsafe { SolArray<u256>::at(2) }
        for _ in empty {
            assert(false)
        }
    }
}

#[test]
fn sol_set_loops() uses (evm: mut Evm) {
    with (RawStorage = evm) {
        let s = unsafe { SolEnumerableSet<u256>::at(3) }
        assert(s.add(5))
        assert(s.add(7))
        assert(s.add(9))
        assert(s.remove(5))
        let mut sum = 0
        for v in s {
            sum += v
        }
        assert(sum == 16)

        let mut order = 0
        for v in s.reversed() {
            order = order * 10 + v
        }
        assert(order == 79)
    }
}
