// A raw-slot constructor's result is the place its handle points to: the
// slot it is given is the handle's field, not the result's.
use std::evm::{Evm, RawStorage, StorageMap, storage_at}

fn bump(_ slot: u256) uses (storage: mut RawStorage) {
    let m = unsafe { storage_at<StorageMap<u256, u256>>(slot) }
    m[1] += 1
}

fn bump_at(_ slot: u256) uses (storage: mut RawStorage) {
    let m = unsafe { StorageMap<u256, u256>::at(slot) }
    m[1] += 1
}

#[test]
fn constructors_take_a_slot_argument() uses (evm: mut Evm) {
    with (RawStorage = evm) {
        bump(3)
        bump(3)
        bump_at(3)
        bump_at(4)
        assert(unsafe { StorageMap<u256, u256>::at(3) }[1] == 3)
        assert(unsafe { StorageMap<u256, u256>::at(4) }[1] == 1)
        assert(unsafe { storage_at<StorageMap<u256, u256>>(4) }[1] == 1)
    }
}
