use std::evm::{Evm, Mutex, StorageMap}

// A storage map's type names its field, so the effect provider holding a
// map gives the authority over it to every copy of it: a local copy, the
// map a projection or a call returns, and an enum payload bound by value.

struct Pair {
    left: StorageMap<u256, u256>,
    right: StorageMap<u256, u256>,
}

// A `mut` parameter of a handle type names its caller's handle; the
// authority over its field is declared.
fn bump(map: mut StorageMap<u256, u256>, key: u256) uses (storage: mut Field(StorageMap<u256, u256>)) {
    map.set(key, value: map.get(key) + 1)
}

enum Slot {
    Map(StorageMap<u256, u256>),
    Empty,
}

msg Msg {
    #[selector = 1]
    Set { key: u256, value: u256 },

    #[selector = 2]
    Copied { key: u256 } -> u256,

    #[selector = 3]
    Projected { key: u256 } -> u256,

    #[selector = 4]
    Peeked { key: u256 } -> u256,

    #[selector = 5]
    Payload { key: u256 } -> u256,

    #[selector = 6]
    Bump { key: u256 } -> u256,
}

pub contract C {
    mut pair: Pair,
    mut guarded: Mutex<StorageMap<u256, u256>>,
    mut slot: Slot,

    recv Msg {
        Set { key, value } uses (mut pair, mut guarded, mut slot) {
            let mut left = pair.left
            left.set(key, value)
            pair.right.set(key, value: value + 1)
            guarded.value_mut().set(key, value: value + 2)
            // A zeroed slot holds its first variant.
            match slot {
                Slot::Map(mut map) => map.set(key, value: value + 3)
                Slot::Empty => {}
            }
        }

        Copied { key } -> u256 uses (pair) {
            let right = pair.right
            pair.left.get(key) + right.get(key)
        }

        Projected { key } -> u256 uses (guarded) {
            guarded.value().get(key)
        }

        Peeked { key } -> u256 uses (guarded) {
            guarded.peek().get(key)
        }

        Bump { key } -> u256 uses (mut pair) {
            bump(map: mut pair.left, key)
            pair.left.get(key)
        }

        Payload { key } -> u256 uses (slot) {
            match slot {
                Slot::Map(map) => map.get(key)
                Slot::Empty => 0
            }
        }
    }
}

#[test]
fn copies_of_a_map_read_its_field() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(addr: c, gas: 300000, value: 0, message: Msg::Set { key: 7, value: 40 })
    let copied: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Copied { key: 7 })
    assert!(copied == 81)
    let projected: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Projected { key: 7 })
    assert!(projected == 42)
    let peeked: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Peeked { key: 7 })
    assert!(peeked == 42)
    let payload: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Payload { key: 7 })
    assert!(payload == 43)
    let bumped: u256 = evm.call(addr: c, gas: 200000, value: 0, message: Msg::Bump { key: 7 })
    assert!(bumped == 41)
}
