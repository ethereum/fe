struct Holder<T> { v: T }
trait Factory {
    type Pair<T>
    type H<T>
}
struct Fac {}
impl Factory for Fac {
    type Pair<T> = (bool, T)
    type H<T> = Holder<T>
}
enum E {
    A(Fac::Pair<u256>),
    S(Fac::H<u256>),
    R { p: Fac::Pair<u256> },
    B,
}
fn val(_ e: E) -> u256 {
    match e {
        E::A(p) => p.1
        E::S(h) => h.v
        E::R { p } => p.1
        E::B => 0
    }
}
#[test]
fn payloads() {
    assert!(val(E::A((true, 1))) == 1)
    assert!(val(E::S(Holder { v: 2 })) == 2)
    assert!(val(E::R { p: (false, 3) }) == 3)
    assert!(val(E::B) == 0)
}
