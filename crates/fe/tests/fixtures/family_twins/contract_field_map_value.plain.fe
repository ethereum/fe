use std::evm::{Evm, StorageMap}
trait Factory { type Val }
struct Fac {}
impl Factory for Fac { type Val = u256 }
msg M {
    #[selector = 1]
    Set { key: u256, value: u256 },
    #[selector = 2]
    Get { key: u256 } -> u256,
}
pub contract C {
    mut a: StorageMap<u256, Fac::Val>,
    recv M {
        Set { key, value } uses (mut a) { a.set(key: key, value: value) }
        Get { key } -> u256 uses (a) { a.get(key: key) }
    }
}
#[test]
fn t() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(addr: c, gas: 200000, value: 0, message: M::Set { key: 7, value: 11 })
    let a: u256 = evm.call(addr: c, gas: 200000, value: 0, message: M::Get { key: 7 })
    assert!(a == 11)
}
