struct Store<T> { a: T, b: T }
trait Factory { type Inner
 type S }
struct Fac {}
impl Factory for Fac { type Inner = (u256, bool)
 type S = Store<Self::Inner> }
struct Rec { s: Fac::S }
fn sum(_ r: Rec) -> u256 { r.s.a.0 + r.s.b.0 }
#[test]
fn f() { assert!(sum(Rec { s: Store { a: (1, true), b: (2, false) } }) == 3) }
