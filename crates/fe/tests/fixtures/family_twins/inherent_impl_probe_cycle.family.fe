trait Factory { type Out<T> }
struct Provider {}
impl Factory for Provider { type Out<T> = (T, u8) }
struct W1<T> {}
enum Payload { A(Provider::Out<u8>) }
impl W1<Provider::Out<u8>> {
    fn m(self) -> u8 { 1 }
}
fn f(p: Payload) -> u8 { match p { Payload::A(x) => x.0 } }
fn g(w: W1<(u8, u8)>) -> u8 { w.m() }
