use std::evm::Evm
struct Store<T> { a: T, b: T }
trait Factory { type S }
struct Fac {}
impl Factory for Fac { type S = Store<u256> }
msg M {
    #[selector = 1]
    Set { a: u256, b: u256 },
    #[selector = 2]
    Sum -> u256,
}
pub contract C {
    mut store: Fac::S
    init() uses (mut store) {
        store.a = 0
        store.b = 0
    }
    recv M {
        Set { a, b } uses (mut store) {
            store.a = a
            store.b = b
        }
        Sum -> u256 uses (store) { store.a * 10 + store.b }
    }
}
#[test]
fn t() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    evm.call(addr: c, gas: 1000000, value: 0, message: M::Set { a: 3, b: 4 })
    let s: u256 = evm.call(addr: c, gas: 1000000, value: 0, message: M::Sum {})
    assert!(s == 34)
}
