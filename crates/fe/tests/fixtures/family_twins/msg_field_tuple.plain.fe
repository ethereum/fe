use std::evm::Evm
trait Factory { type Tup
 type Tup8 }
struct Fac {}
impl Factory for Fac { type Tup = (u256, u256)
 type Tup8 = (u8, u256) }
msg M {
    #[selector = 2]
    Sum { t: Fac::Tup } -> u256,
    #[selector = 3]
    Small { t: u256 } -> Fac::Tup8,
}
pub contract C {
    recv M {
        Sum { t } -> u256 { t.0 + t.1 }
        Small { t } -> Fac::Tup8 { (5, t + 1) }
    }
}
#[test]
fn msg_abi() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    let s: u256 = evm.call(addr: c, gas: 1000000, value: 0, message: M::Sum { t: (5, 6) })
    assert!(s == 11)
    let q: (u8, u256) = evm.call(addr: c, gas: 1000000, value: 0, message: M::Small { t: 6 })
    assert!(q.0 == 5)
    assert!(q.1 == 7)
}
