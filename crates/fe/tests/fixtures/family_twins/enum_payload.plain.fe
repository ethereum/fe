struct Holder<T> { v: T }
trait Factory {
    type Pair
    type H
}
struct Fac {}
impl Factory for Fac {
    type Pair = (bool, u256)
    type H = Holder<u256>
}
enum E {
    A(Fac::Pair),
    S(Fac::H),
    R { p: Fac::Pair },
    B,
}
fn val(_ e: E) -> u256 {
    match e {
        E::A(p) => p.1
        E::S(h) => h.v
        E::R { p } => p.1
        E::B => 0
    }
}
#[test]
fn payloads() {
    assert!(val(E::A((true, 1))) == 1)
    assert!(val(E::S(Holder { v: 2 })) == 2)
    assert!(val(E::R { p: (false, 3) }) == 3)
    assert!(val(E::B) == 0)
}
