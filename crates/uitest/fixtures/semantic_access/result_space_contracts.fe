// A declared result-space contract holds every yield in every instance. An
// implementation's methods hold to their trait method's contracts, whose
// associated spaces the implementation gives.
trait Slot {
    space S
    fn slot(mut self) -> mut u256 @S
}

struct WrittenBack { n: u256 }

impl Slot for WrittenBack {
    space S = memory

    fn slot(mut self) -> mut u256 {
        let mut tmp = self.n
        yield mut tmp
        self.n = tmp
    }
}

// Rejected for a storage `Direct`: it yields its own place, not memory.
struct Direct { n: u256 }

impl Slot for Direct {
    space S = memory

    fn slot(mut self) -> mut u256 {
        mut self.n
    }
}

struct Holder { n: u256 }

impl Holder {
    fn own_place(mut self) -> mut u256 @self {
        mut self.n
    }

    fn frame(mut self) -> (u256, mut u256) @memory {
        let mut tmp = self.n
        yield (0, mut tmp)
        self.n = tmp
    }

    // Rejected for a storage `Holder`.
    fn mislabeled(mut self) -> mut u256 @memory {
        mut self.n
    }
}

msg Use {
    #[selector = 1]
    Go,
}

pub contract Spaces {
    mut written_back: WrittenBack,
    mut direct: Direct,
    mut holder: Holder,

    recv Use {
        Go uses (mut written_back, mut direct, mut holder) {
            let a = written_back.slot()
            a += 1
            let b = direct.slot()
            b += 1
            let c = holder.own_place()
            c += 1
            let (_, d) = holder.frame()
            d += 1
            let e = holder.mislabeled()
            e += 1
        }
    }
}
