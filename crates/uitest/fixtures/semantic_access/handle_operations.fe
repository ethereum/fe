// An operation through a handle accesses the entries of the field it names
// for its duration, under the `Field(Self)` authority it declares. A copy
// names the field it was copied from, since a handle's type names its field.
// A call under a `Field` authority accesses the fields of the handles its
// arguments hold.
use std::evm::StorageMap

// A data parameter carries no authority, so the caller grants it.
fn store_owned(_ map: own StorageMap<u256, u256>) uses (storage: mut Field(StorageMap<u256, u256>)) {
    let mut copy = map
    let access = mut copy
    access.set(key: 1, value: 3)
}

// Rejected: `set` writes the field the session holds.
pub contract Direct {
    mut m: StorageMap<u256, u256>,
    init() uses (mut m) {
        let x = mut m[1]
        m.set(key: 2, value: 5)
        x += 1
    }
}

// Rejected: a copy of the handle reads the same field.
pub contract Copied {
    mut m: StorageMap<u256, u256>,
    init() uses (mut m) {
        let h = m
        let x = mut m[1]
        let v = h.get(2)
        x += v
    }
}

// Rejected: a copy passed by value still names the field.
pub contract Owned {
    mut m: StorageMap<u256, u256>,
    init() uses (mut m) {
        let x = mut m[1]
        store_owned(m)
        x += 1
    }
}

// Rejected: a copy installed as a provider names the field too.
pub contract Provided {
    mut m: StorageMap<u256, u256>,
    init() uses (mut m) {
        let mut h = m
        let x = mut m[1]
        with (h) {
            h.set(key: 2, value: 5)
        }
        x += 1
    }
}

// Accepted: the session ends before the write.
pub contract Sequential {
    mut m: StorageMap<u256, u256>,
    init() uses (mut m) {
        let mut h = m
        let x = mut m[1]
        x += 1
        h.set(key: 2, value: 5)
    }
}

// Accepted: maps read from distinct contract fields name disjoint fields.
pub contract Distinct {
    mut a: StorageMap<u256, u256>,
    mut b: StorageMap<u256, u256>,
    init() uses (mut a, b) {
        let x = mut a[1]
        let v = b.get(1)
        x += v
    }
}

struct Pair {
    left: StorageMap<u256, u256>,
    right: StorageMap<u256, u256>,
}

// The caller grants the authority over `pair`'s maps, which leaves the map's
// salt open: any map of that shape.
fn read_left(_ pair: Pair, _ key: u256) -> u256 uses (storage: Field(StorageMap<u256, u256>)) {
    let left = pair.left
    left.get(key)
}

// Accepted: a field of an argument in an effect gives the authority.
pub contract Nested {
    mut pair: Pair,
    init() uses (mut pair) {
        pair.left.set(key: 1, value: read_left(pair, 1) + 1)
    }
}

// Rejected: the authority `read_left` holds reaches any map of its shape,
// including the one a session holds.
pub contract NestedSession {
    mut pair: Pair,
    init() uses (mut pair) {
        let x = mut pair.right[1]
        let v = read_left(pair, 1)
        x += v
    }
}

struct Holder {
    map: StorageMap<u256, u256>,
}

// The caller grants the authority over `copy`'s map and over the map
// `holder` holds.
fn write_held(_ copy: StorageMap<u256, u256>) uses (storage: mut Field(StorageMap<u256, u256>), holder: Holder) {
    let mut map = holder.map
    map.set(key: 1, value: copy.get(1))
}

// Rejected: `write_held` may write the map its effect holds, which a session
// holds.
pub contract HeldSession {
    mut a: Holder,
    mut b: Holder,
    init() uses (mut a, mut b) {
        let x = ref b.map[1]
        with (Holder = b) {
            write_held(a.map)
        }
        let _ = x + 1
    }
}
