use std::evm::{Address, StorageMap}

// `map[k]` on a storage map opens a write-back session that reserves the
// map's field domain, `Field(Self)`, until its grant ends.

struct Store {
    counts: StorageMap<u256, u256>,
    other: StorageMap<u256, u256>,
}

pub struct Ledger {
    pub balances: StorageMap<Address, u256>,
}

impl Ledger {
    // A handle reached through a `mut` parameter carries its authority.
    fn credit(mut self, _ to: Address, amount: u256) {
        self.balances[to] += amount
    }
}

// Rejected: the element's session holds `counts` while it is written.
fn same_field(_ key: u256) uses (store: mut Store) {
    let x = mut store.counts[key]
    store.counts[key + 1] = 3
    x += 1
}

// Accepted: the maps of a contract field lie in their own fields, which are
// disjoint.
pub contract Distinct {
    mut store: Store,
    init() uses (mut store) {
        let x = mut store.counts[1]
        store.other[1] = 3
        x += 1
    }
}

// Rejected: a provided `Store` may be a memory value holding copies of one
// map, so its handles may name the same field.
fn provided_fields(_ key: u256) uses (store: mut Store) {
    let x = mut store.counts[key]
    store.other[key] = 3
    x += 1
}

// Accepted: the session finishes at its grant's last use.
fn sequential(_ key: u256) uses (store: mut Store) {
    let x = mut store.counts[key]
    x += 1
    store.counts[key] += 1
}

// Rejected: a read of the field while its write-back session is open.
fn read_during_write(_ key: u256) -> u256 uses (store: mut Store) {
    let x = mut store.counts[key]
    let y = store.counts[key]
    x += 1
    y
}
