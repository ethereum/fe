// A loop mutating two bases at once holds a `mut` access to each, so the
// bases must be disjoint.
use core::iter::zip

struct Pair { a: [u256; 2], b: [u256; 2] }

// Rejected: one place is both bases.
fn same_base() {
    var xs: [u256; 2] = [1, 2]
    for (mut x, mut y) in (xs, xs) by zip() {
        x += y
    }
}

// Rejected: one base contains the other.
fn nested_bases() {
    var p = Pair { a: [1, 2], b: [3, 4] }
    for (mut x, mut y) in (p.a, p.a) by zip() {
        x += y
    }
}

// Accepted: disjoint fields of one owner.
fn disjoint_fields() -> u256 {
    var p = Pair { a: [1, 2], b: [3, 4] }
    for (mut x, mut y) in (p.a, p.b) by zip() {
        y += x
    }
    p.b[0]
}
