// A contract may name a sub-place of a parameter or effect, `@self.value`,
// `@self[_]`: its space is the one the path reaches, through pinned types,
// entries and lanes. An implementation's `space S = self[_]` is where its
// elements lie, so a packed collection exports memory (S-50) and a plain
// `@self` on a yield that crosses a pin is a mismatch (S-51).
use core::effect_ref::StateSpace
use core::iter::Collection
use core::ops::{LaneCodec, StateIndex}
use core::option::Option
use std::evm::{TSlot, keccak_words}

struct ByteLanes {}

impl LaneCodec<u8> for ByteLanes {
    const BITS: u256 = 8

    fn get(_ word: u256, offset: u256) -> u8 {
        ((word >> offset) & 0xff).downcast_truncate()
    }

    fn set(_ word: u256, offset: u256, value: own u8) -> u256 {
        (word & !(0xff << offset)) | ((value as u256) << offset)
    }
}

// Bytes packed 32 to a word.
struct Bytes {}

impl StateIndex for Bytes {
    const SPACE: StateSpace = StateSpace::Storage
    type Key = u256
    type Entry = u8
    type Lanes = ByteLanes

    fn locate(self, _ root: u256, _ key: u256) -> (u256, u256) {
        (keccak_words([key / 32, root]), (key % 32) * 8)
    }
}

// Accepted: its elements are lanes, whose grants lie in memory.
impl Collection for Bytes {
    space S = self[_]
    type Cursor = u256
    type Item = u8

    fn start(self) -> Option<u256> {
        Option::Some(0)
    }

    fn next(self, _ c: u256) -> Option<u256> {
        if c < 31 { Option::Some(c + 1) } else { Option::None }
    }

    fn at(self, _ c: u256) -> ref u8 {
        ref self[c]
    }
}

// The same bytes, promising the collection's own space.
struct PromisedBytes {}

impl StateIndex for PromisedBytes {
    const SPACE: StateSpace = StateSpace::Storage
    type Key = u256
    type Entry = u8
    type Lanes = ByteLanes

    fn locate(self, _ root: u256, _ key: u256) -> (u256, u256) {
        (keccak_words([key / 32, root]), (key % 32) * 8)
    }
}

// Rejected: storage is promised, but a lane's grant is a memory copy.
impl Collection for PromisedBytes {
    space S = self
    type Cursor = u256
    type Item = u8

    fn start(self) -> Option<u256> {
        Option::Some(0)
    }

    fn next(self, _ c: u256) -> Option<u256> {
        if c < 31 { Option::Some(c + 1) } else { Option::None }
    }

    fn at(self, _ c: u256) -> ref u8 {
        ref self[c]
    }
}

struct Guarded {
    locked: TSlot<bool>,
    value: u256,
    pair: (u256, bool),
}

impl Guarded {
    // Accepted: each names the space of the sub-place it yields.
    fn locked_mut(mut self) -> mut bool @self.locked {
        mut self.locked[()]
    }

    fn value_mut(mut self) -> mut u256 @self.value {
        mut self.value
    }

    fn first(mut self) -> mut u256 @self.pair.0 {
        mut self.pair.0
    }

    // Rejected: the yield crosses `locked`'s pin, so `@self` is a mismatch.
    fn plain(mut self) -> mut bool @self {
        mut self.locked[()]
    }
}

// Accepted: a sub-place of an effect's target.
fn locked_of() -> mut bool @g.locked uses (g: mut Guarded) {
    mut g.locked[()]
}

// Rejected: `value` lies in storage, the yield in transient storage.
fn mislabeled() -> mut bool @g.value uses (g: mut Guarded) {
    mut g.locked[()]
}

msg M {
    #[selector = 1]
    Go -> u256,
}

pub contract C {
    mut g: Guarded,
    mut bytes: Bytes,
    mut promised: PromisedBytes,

    recv M {
        Go -> u256 uses (mut g, mut bytes, mut promised) {
            let l = g.locked_mut()
            l = true
            let v = g.value_mut()
            v += 1
            let f = g.first()
            f += 1
            let p = g.plain()
            p = false
            with (Guarded = g) {
                let k = locked_of()
                k = false
                let m = mislabeled()
                m = true
            }
            let b = bytes.at(0)
            let c = promised.at(0)
            b as u256 + c as u256
        }
    }
}
