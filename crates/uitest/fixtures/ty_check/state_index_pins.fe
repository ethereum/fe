use core::marker::Pinned
use core::ops::{Location, StateIndex}
use std::evm::Ctx

// Implementing `Pinned` pins the implementor to its space `S`: it is
// state-only. A memory collection implements `Index` instead.
struct Cells {
    len: u256,
}

impl Pinned for Cells {
    space S = storage
}

impl StateIndex for Cells {
    type Key = u256
    type Entry = u256

    fn locate(self, _ root: u256, _ key: u256) -> Location {
        Location { slot: root + 1 + key % 8, offset: 0 }
    }
}

// Rejected: a type is pinned to a state space.
struct Words {
    base: u256,
}

impl Pinned for Words {
    space S = memory
}

// Rejected: a pinned type is never constructed as a memory value.
fn make_cells() {
    let _cells = Cells { len: 0 }
}

// Rejected: `locate` declares no effects.
struct Noisy {
    len: u256,
}

impl Pinned for Noisy {
    space S = storage
}

impl StateIndex for Noisy {
    type Key = u256
    type Entry = u256

    fn locate(self, _ root: u256, _ key: u256) -> Location uses (ctx: Ctx) {
        Location { slot: root + key + ctx.address().inner, offset: 0 }
    }
}

// A pin belongs to the implementation that applies to each instance.
struct InStorage {}

impl Pinned for InStorage {
    space S = storage
}

struct InTransient {}

impl Pinned for InTransient {
    space S = transient
}

struct Cell<P> {
    base: u256,
}

impl<P: Pinned> Pinned for Cell<P> {
    space S = P::S
}

// Rejected: `Cell<InStorage>` is pinned to storage.
fn make_stored_cell() {
    let _cell: Cell<InStorage> = Cell { base: 0 }
}

// Rejected: `Cell<InTransient>` is pinned to transient storage.
fn make_transient_cell() {
    let _cell: Cell<InTransient> = Cell { base: 0 }
}

// Rejected: some `Cell<P>` is pinned.
fn make_any_cell<P: Pinned>() {
    let _cell: Cell<P> = Cell { base: 0 }
}

struct Split<P> {
    base: u256,
}

impl Pinned for Split<InStorage> {
    space S = storage
}

struct Unplaced {}

// Accepted: no implementation applies to `Split<Unplaced>`.
fn make_unplaced_split() -> Split<Unplaced> {
    Split { base: 0 }
}

// Rejected: the implementation for `Split<InStorage>` pins it.
fn make_stored_split() {
    let _split: Split<InStorage> = Split { base: 0 }
}

// Rejected: a forwarded space is another pinned type's.
trait Placement {
    space S
}

struct Forwarded<P> {}

impl<P: Placement> Pinned for Forwarded<P> {
    space S = P::S
}
