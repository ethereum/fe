use core::marker::Pinned
use core::ops::Index

// An associated space or an effect row must end somewhere: one that names
// itself, directly or through other implementations, is rejected rather than
// followed forever.
struct Named {
    v: u256,
}

// Rejected: `Named::S` is this space.
impl Pinned for Named {
    space S = Named::S
}

struct Own {
    v: u256,
}

// Rejected: `Self::S` is this space.
impl Pinned for Own {
    space S = Self::S
}

trait Two {
    space A
    space B
}

struct Pair {
    v: u256,
}

// Rejected: each space names the other.
impl Two for Pair {
    space A = Self::B
    space B = Self::A
}

trait Other {
    space T
}

trait Marker: Pinned {}

struct Left {
    pub v: u256,
}

struct Right {
    pub v: u256,
}

impl Marker for Left {}

// Rejected: the two implementations name each other's space.
impl Pinned for Left
    where Right: Other
{
    space S = Right::T
}

impl Other for Right
    where Left: Marker
{
    space T = Left::S
}

struct Words {
    v: u256,
}

// Rejected: an index's result space and its effect row each name themselves.
impl Index<u256> for Words {
    uses E = Self::E
    space S = Words::S
    type Output = u256

    fn index(self, _ i: u256) -> ref u256 @S {
        ref self.v
    }
}
