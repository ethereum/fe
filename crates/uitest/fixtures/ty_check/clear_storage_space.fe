// `clear_storage` zeroes an element only where every type's zero is a value:
// in storage or transient storage. A collection keeping its elements in
// memory cannot use it.
use core::effect_ref::AddressSpace
use core::ops::{PlaceIndex, clear_storage}

struct Words { base: u256 }

impl PlaceIndex for Words {
    const SPACE: AddressSpace = AddressSpace::Memory
    type Key = u256
    type Entry = u256

    fn locate(self, _ root: u256, _ index: u256) -> (u256, u256) {
        (root + index * 32, 0)
    }
}

fn reset(_ words: mut Words) {
    clear_storage(mut words, 0)
}
