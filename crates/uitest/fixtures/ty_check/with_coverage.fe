use std::evm::StorageMap
use std::evm::effects::{RawStorage, StorPtr}

// A `with` provider naming existing storage needs the function's own
// authority, so its interference stays in the function's contract.

fn read(_ p: StorPtr<u256>) -> u256 uses (target: u256) {
    target
}

// Rejected: nothing in the signature covers the slot `p` names.
fn uncovered(_ p: StorPtr<u256>) -> u256 {
    let ptr = p
    with (ptr) {
        read(ptr)
    }
}

// Accepted: raw storage authority covers any slot.
fn raw(_ p: StorPtr<u256>) -> u256 uses (storage: RawStorage) {
    let ptr = p
    with (ptr) {
        read(ptr)
    }
}

// Rejected: a provider that can write needs authority that can.
fn raw_read_only(_ p: StorPtr<u256>) -> u256 uses (storage: RawStorage) {
    let mut ptr = p
    with (ptr) {
        read(ptr)
    }
}

// Accepted: the authority over the slot a handle of this type names.
fn field(_ p: StorPtr<u256>) -> u256 uses (storage: Field(StorPtr<u256>)) {
    let ptr = p
    with (ptr) {
        read(ptr)
    }
}

// Accepted: an `unsafe` block vouches for the provider.
fn vouched(_ p: StorPtr<u256>) -> u256 {
    let ptr = p
    unsafe {
        with (ptr) {
            read(ptr)
        }
    }
}

struct Store {
    ptr: StorPtr<u256>,
}

// Accepted: a place in the function's own effect carries its authority.
fn own_effect() -> u256 uses (store: Store) {
    with (store.ptr) {
        read(store.ptr)
    }
}

fn count() -> u256 uses (counts: StorageMap<u256, u256>) {
    counts.get(0)
}

// Rejected: a storage map names its field wherever the handle lies, so a
// copy installed as a provider needs authority over that field.
fn uncovered_map(_ map: StorageMap<u256, u256>) -> u256 {
    let counts = map
    with (counts) {
        count()
    }
}

// Accepted: the authority over the field a map of this type names.
fn covered_map(_ map: StorageMap<u256, u256>) -> u256
    uses (storage: Field(StorageMap<u256, u256>))
{
    let counts = map
    with (counts) {
        count()
    }
}
