// A value of an associated shape not known here is only passed on: returned,
// or passed to a parameter of the same shape.
trait Driver {
    shape Step

    fn at(mut? self) -> Self::Step
}

struct Pair {
    a: u256,
    b: u256,
}

impl Driver for Pair {
    shape Step = (mut? u256, mut? u256)

    fn at(mut? self) -> (mut? u256, mut? u256) {
        (mut? self.a, mut? self.b)
    }
}


fn take<D: Driver>(_ s: D::Step<ref>) {}

fn bind<D: Driver>(_ s: D::Step<ref>) {
    let t = s
}

fn destructure<D: Driver>(_ s: D::Step<ref>) {
    let (a, b) = s
}

fn field<D: Driver>(_ s: D::Step<ref>) -> u256 {
    s.0
}

fn wrong<D: Driver>(_ s: D::Step<ref>) {
    let x: u256 = 1
    take<D>(x)
}

fn other_mode<D: Driver>(_ s: D::Step<mut>) {
    take<D>(s)
}

// Outside a `mut?` function, a parameter's shape needs its mode.
fn bare<D: Driver>(_ s: D::Step) {}

// A shape's parts carry its modes.
fn moded<D: Driver>(_ s: own D::Step<ref>) {}
