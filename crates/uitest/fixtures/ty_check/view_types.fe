// A `#[view]` type exists only behind view parameters and `ref` results.
mod views {
    #[view]
    pub struct Span {
        pub start: u256,
        pub len: u256,
    }

    pub struct Owner {
        pub start: u256,
        pub len: u256,
    }

    impl Owner {
        // Its defining module builds a span as a session-owned temporary.
        pub fn span(self) -> ref Span {
            let span = Span { start: self.start, len: self.len }
            ref span
        }
    }

    fn swap<T>(_ a: mut T, _ b: mut T) {}

    fn reaccess() {
        var a = Span { start: 0, len: 1 }
        var b = Span { start: 1, len: 1 }
        swap(mut a, mut b)
    }
}

use views::{Owner, Span}

fn viewed(_ span: Span) -> u256 {
    span.len
}

fn owned(_ span: own Span) {}

fn inout(_ span: mut Span) {}

trait Make {
    fn make() -> Span
    fn span_mut(mut self) -> mut Span
    fn both(mut self) -> (ref Span, mut Span)
}

struct Holder {
    span: Span,
}

enum Either {
    Left(Span),
    Right,
}

fn pair(_ p: (Span, u256)) {}

fn maybe(_ s: Option<Span>) {}

type Spans = [Span; 2]

fn spans(_ s: Spans) {}

impl Copy for Span {}

fn outside() -> u256 {
    let span = Span { start: 0, len: 0 }
    span.len
}

fn take<T>(_ x: own T) {}

fn take_viewed(owner: Owner) {
    take(owner.span())
}

trait HasSpan {
    type S
}

impl HasSpan for Owner {
    type S = Span
}

fn take_assoc<T: HasSpan>(_ x: own T::S) {}

fn take_assoc_viewed(owner: Owner) {
    take_assoc<Owner>(owner.span())
}

#[view(read)]
struct Malformed {}

#[view]
fn not_a_type() {}
