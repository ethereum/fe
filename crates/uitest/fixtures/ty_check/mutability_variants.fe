use core::iter::{Collection, CollectionMut}

// Read and mutable projections are distinct methods, whatever the context
// needs: `at` yields a view, which cannot be written.
fn view_is_not_writable() {
    var xs: [u256; 2] = [1, 2]
    xs.at(0) = 3
}

// `at_mut` needs a mutable receiver.
fn immutable_receiver() {
    let xs: [u256; 2] = [1, 2]
    let x = xs.at_mut(0)
    x = 3
}

// A read binds a view.
fn read_is_not_a_place() {
    var xs: [u256; 2] = [1, 2]
    let x = xs.at(0)
    x = 3
}
