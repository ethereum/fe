// A view may be accessed mutably: a `mut` span from its owner writes the
// owner's elements, components are marked `mut` like any others, and a
// `mut` view comes only from a projection that holds something mutably.
use core::ptr::{MemBuffer, MemSlice, MemSpan}

// S-72. Accepted: a generic body writing through a `mut` view.
fn fill<T: Copy>(_ s: mut MemSlice<T>, _ v: T) {
    for mut x in s {
        x = v
    }
}

// S-72. Accepted: the marked halves of a split write.
fn halves(_ buf: mut MemBuffer) {
    let s = buf.span_mut()
    let (mut a, mut b) = s.split_at_mut(1)
    a[0] = 1
    b[0] = 2
}

// S-72. Rejected: plain halves are read accesses.
fn plain_halves(_ buf: mut MemBuffer) {
    let s = buf.span_mut()
    let (a, b) = s.split_at_mut(1)
    a[0] = 1
    b[0] = 2
}

// S-72. Rejected: a view has no value for `var` to hold.
fn var_span(_ buf: mut MemBuffer) {
    var s = buf.span_mut()
}

// S-72. Rejected: nothing here is held mutably, so the grant could write an
// owner its caller only reads.
fn view_mut(_ buf: MemBuffer) -> mut MemSpan {
    unsafe { MemSpan::from_raw_parts_mut(ptr: buf.ptr(), len: buf.len()) }
}
