use std::abi::sol

msg M {
    #[selector = 0x01]
    V { n: u256 } -> u256,
}

mod inner {
    msg Hidden {
        #[selector = 0x02]
        V { n: u256 } -> u256,
    }
}

mod outer {
    mod hidden {
        pub use ingot::M
    }
}

// A variant whose type argument the arm must give.
pub struct Generic<T> {
    pub value: u8,
}

impl<T> core::abi::AbiSize for Generic<T> {
    const HEAD_SIZE: u256 = 32
    const IS_DYNAMIC: bool = false

    fn payload_size(self) -> u256 {
        32
    }
}

impl<T> core::abi::Encode<std::abi::Sol> for Generic<T> {
    fn encode(own self, _ out: core::abi::AbiFrame) {
        let Self { value } = self
        value.encode(out)
    }
}

impl<T> core::abi::Decode<std::abi::Sol> for Generic<T> {
    fn decode_payload<D: core::abi::AbiDecoder<std::abi::Sol>, I: core::abi::ByteInput>(_ d: mut D, _ input: I) -> Self {
        let value = u8::decode_payload(mut d, input)
        Self { value }
    }
}

impl core::message::MsgVariant<std::abi::Sol> for Generic<u8> {
    const SELECTOR: u32 = sol("generic(uint8)")
    type Return = u8
}

// An arm's path is resolved only by its recv block, which reports what
// resolving the path where the arm is written would.
pub contract Bare {
    recv {
        inner::Hidden::V { n } -> u256 {
            n
        }
        Generic { value } -> u8 {
            value
        }
        Generic<u8> { value } -> u8 {
            value
        }
        Nope { x } -> u256 {
            x
        }
        M::W { y } -> u256 {
            y
        }
        Gone -> u256 {
            1
        }
        inner { z } -> u256 {
            z
        }
    }
}

pub contract Named {
    recv M {
        outer::hidden::M::V { n } -> u256 {
            n
        }
    }
}
