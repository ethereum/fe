// An associated type binding of a bound names a type as a trait argument
// does: one that needs another bound waits for it, and one that names no
// type is reported at the binding.
trait Ty {
    type T
}

trait Get {
    type Out
}

trait Conv<X> {}

fn helper() {}

// Accepted: the binding names another parameter's associated type, in
// either order or in a where clause.
fn later<G: Get<Out = Q::T>, Q: Ty>() {}

fn earlier<Q: Ty, G: Get<Out = Q::T>>() {}

fn in_where<G, Q>()
    where G: Get<Out = Q::T>, Q: Ty
{}

// Rejected: `Nope` is not found.
fn undefined<G: Get<Out = Nope>>() {}

// Rejected: `Q` has no bound with a `T`.
fn unbound<G: Get<Out = Q::T>, Q>() {}

// Rejected: `helper` is a function.
fn not_a_type<G: Get<Out = helper>>() {}

// Rejected: a trait argument's error is reported at the argument too.
fn undefined_arg<P: Conv<Nope>>() {}
