// A family application written in an alias is checked where the alias is
// defined. A generic alias is checked like a generic struct: its own
// parameters have no bounds, so the definition reports an argument they do
// not meet. The application stands for its definition once written, so the
// uses of an alias that fails are not reported again.
trait Allowed {}
impl Allowed for bool {}
struct Other {}
struct Wrap<T> {}
impl<T> Allowed for Wrap<T> {}

trait Factory {
    type Out<T: Allowed>
}
struct Provider {}
impl Factory for Provider {
    type Out<T> = Wrap<T>
}

type Concrete = Provider::Out<Other>
type Generic<T> = Provider::Out<T>
type Nested<T> = Wrap<Generic<T>>
type Defaulted<T = Other> = Provider::Out<T>
type DefaultOk<T = bool> = Provider::Out<T>

// These use aliases whose definitions are reported.
struct ViaConcrete { f: Concrete }
struct Field { f: Generic<Other> }
struct ThroughNested { f: Nested<Other> }
struct GenericUse<T> { f: Generic<T> }
fn param(_ x: Generic<Other>) {}
fn ret() -> Generic<Other> { make() }
fn local<T>() {
    let _a: Generic<T> = make()
    let _b: Defaulted = make()
}
impl<T> Wrap<Generic<T>> {}
trait Tr { const C: Generic<Other> }
struct LeftToDefault { f: Defaulted }
struct GivenDefault { f: Defaulted<Other> }

// These meet the bound and are accepted.
struct DefaultedOk { f: DefaultOk }
struct GivenOk { f: Defaulted<bool> }
fn bounded<T: Allowed>(_ x: Generic<T>) -> Nested<bool> { make() }
type Always<T> = Provider::Out<Wrap<T>>
fn always(_ x: Always<u8>) -> Always<u8> { x }

fn make<T>() -> T { make() }
