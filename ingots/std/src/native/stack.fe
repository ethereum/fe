use core::{Option, Result, size_of}
use core::ptr
use ingot::native::bytes::{malloc, free, is_null}

/// Fixed-capacity native storage with explicit ownership and release.
/// Drain owned elements before releasing the empty stack.
pub struct FixedStack<T, const CAPACITY: usize> {
    unsafe slots: *[Option<T>; CAPACITY],
    unsafe len: usize,
}

impl<T, const CAPACITY: usize> FixedStack<T, CAPACITY> {
    /// Allocate once and initialize slots in place; allocation failure returns None.
    pub fn try_new() -> Option<Self> {
        let size = size_of<[Option<T>; CAPACITY]>()
        if size > 0x7fffffffffffffff { return Option::None }
        let address = malloc(size: if size == 0 { 1 } else { size.downcast_unchecked() })
        if is_null(address) { return Option::None }
        let slots = ptr::cast<u8, [Option<T>; CAPACITY]>(address)
        var index: usize = 0
        // The allocation fits every slot; None initializes each variant tag.
        unsafe {
            while index < CAPACITY {
                (*slots)[index] = Option::None
                index += 1
            }
            Option::Some(Self { slots, len: 0 })
        }
    }

    pub fn len(self) -> usize { self.len }

    /// Preserve the supplied value if the stack is full; pushing does not allocate.
    pub fn try_push(mut self, _ value: own T) -> Result<T, ()> {
        if self.len == CAPACITY { return Result::Err(value) }
        // The next slot is initialized to None and lies within the allocation.
        unsafe {
            (*self.slots)[self.len] = Option::Some(value)
            self.len += 1
        }
        Result::Ok(())
    }

    /// The mutable projection reserves the stack until its caller's last use.
    pub fn top_mut(mut self) -> mut T {
        core::assert(self.len > 0)
        // Every occupied slot contains Some; the stack owns its allocation.
        unsafe {
            match (*self.slots)[self.len - 1] {
                Option::Some(mut value) => mut value,
                Option::None => core::panic(),
            }
        }
    }

    pub fn pop(mut self) -> T {
        core::assert(self.len > 0)
        let index = self.len - 1
        // Move the initialized owner out and refill its slot before it is reused.
        let value = unsafe {
            let value = (*self.slots)[index]
            (*self.slots)[index] = Option::None
            self.len = index
            value
        }
        match value { Option::Some(value) => value, Option::None => core::panic() }
    }

    /// Release empty storage. Owned elements must first be popped and consumed.
    pub fn release(own self) {
        core::assert(self.len == 0)
        unsafe { free(ptr::cast<[Option<T>; CAPACITY], u8>(self.slots)) }
    }
}
