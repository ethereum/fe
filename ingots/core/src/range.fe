use ingot::iter::{Bidirectional, Collection}
use ingot::option::Option
use ingot::ops::{WrappingAdd, WrappingSub}

/// Trait for range bounds - either compile-time known or runtime.
pub trait Bound {
    /// The runtime representation of this bound.
    /// `()` for Known (value is in the type), `usize` for Unknown.
    type Repr
}

/// A compile-time known bound value.
pub struct Known<const N: usize> {}

/// A runtime bound value.
pub struct Unknown {}

impl<const N: usize> Bound for Known<N> {
    type Repr = ()
}

impl Bound for Unknown {
    type Repr = usize
}

/// A range from start to end (exclusive).
///
/// The bounds can be either compile-time known (`Known<N>`) or runtime (`Unknown`).
/// This allows for zero-cost ranges when bounds are known at compile time:
/// - `Range<Known<0>, Known<10>>` - 0 words (fully const)
/// - `Range<Known<0>, Unknown>` - 1 word (common `0..n` pattern)
/// - `Range<Unknown, Unknown>` - 2 words (fully dynamic)
pub struct Range<S: Bound, E: Bound> {
    pub start: <S as Bound>::Repr,
    pub end: <E as Bound>::Repr,
}

// A range's cursor is its value, which it yields as a temporary. A valid
// cursor lies in the range, so stepping from it cannot overflow.
#[inline(always)]
fn range_start(_ lo: usize, _ hi: usize) -> Option<usize> {
    if lo < hi { Option::Some(lo) } else { Option::None }
}

#[inline(always)]
fn range_next(_ c: usize, _ hi: usize) -> Option<usize> {
    let next = c.wrapping_add(1)
    if next < hi { Option::Some(next) } else { Option::None }
}

#[inline(always)]
fn range_last(_ lo: usize, _ hi: usize) -> Option<usize> {
    if lo < hi { Option::Some(hi.wrapping_sub(1)) } else { Option::None }
}

#[inline(always)]
fn range_prev(_ c: usize, _ lo: usize) -> Option<usize> {
    if c > lo { Option::Some(c.wrapping_sub(1)) } else { Option::None }
}

/// Fully const range: `Known<LO>..Known<HI>`
impl<const LO: usize, const HI: usize> Collection for Range<Known<LO>, Known<HI>> {
    space S = memory
    type Cursor = usize
    type Item = usize

    #[inline(always)]
    fn start(self) -> Option<usize> {
        range_start(LO, HI)
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        range_next(c, HI)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref usize {
        ref c
    }
}

impl<const LO: usize, const HI: usize> Bidirectional for Range<Known<LO>, Known<HI>> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        range_last(LO, HI)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        range_prev(c, LO)
    }
}

/// Const start, dynamic end: `Known<LO>..n` (common `0..n` pattern)
impl<const LO: usize> Collection for Range<Known<LO>, Unknown> {
    space S = memory
    type Cursor = usize
    type Item = usize

    #[inline(always)]
    fn start(self) -> Option<usize> {
        range_start(LO, self.end)
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        range_next(c, self.end)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref usize {
        ref c
    }
}

impl<const LO: usize> Bidirectional for Range<Known<LO>, Unknown> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        range_last(LO, self.end)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        range_prev(c, LO)
    }
}

/// Dynamic start, const end: `n..Known<HI>`
impl<const HI: usize> Collection for Range<Unknown, Known<HI>> {
    space S = memory
    type Cursor = usize
    type Item = usize

    #[inline(always)]
    fn start(self) -> Option<usize> {
        range_start(self.start, HI)
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        range_next(c, HI)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref usize {
        ref c
    }
}

impl<const HI: usize> Bidirectional for Range<Unknown, Known<HI>> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        range_last(self.start, HI)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        range_prev(c, self.start)
    }
}

/// Fully dynamic range: `start..end`
impl Collection for Range<Unknown, Unknown> {
    space S = memory
    type Cursor = usize
    type Item = usize

    #[inline(always)]
    fn start(self) -> Option<usize> {
        range_start(self.start, self.end)
    }

    #[inline(always)]
    fn next(self, _ c: usize) -> Option<usize> {
        range_next(c, self.end)
    }

    #[inline(always)]
    fn at(self, _ c: usize) -> ref usize {
        ref c
    }
}

impl Bidirectional for Range<Unknown, Unknown> {
    #[inline(always)]
    fn last(self) -> Option<usize> {
        range_last(self.start, self.end)
    }

    #[inline(always)]
    fn prev(self, _ c: usize) -> Option<usize> {
        range_prev(c, self.start)
    }
}
