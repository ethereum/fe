pub trait Not {
    type Output = Self

    fn not(own self) -> Self::Output
}

pub trait BitNot {
    type Output = Self

    fn bit_not(own self) -> Self::Output
}

// Comparison operators
pub trait Eq<T = Self> {
    fn eq(self, _ other: T) -> bool
    fn ne(self, _ other: T) -> bool {
        !self.eq(other)
    }
}

// Aggregate comparisons use element Eq implementations and short-circuit.
impl<T: Eq, const N: usize> Eq for [T; N] {
    fn eq(self, _ other: [T; N]) -> bool {
        let mut i: usize = 0
        while i < N {
            if !(self[i] == other[i]) {
                return false
            }
            i += 1
        }
        true
    }
}

impl Eq for () {
    fn eq(self, _ other: ()) -> bool {
        true
    }
}

impl<T0> Eq for (T0,) where T0: Eq {
    fn eq(self, _ other: (T0,)) -> bool {
        self.0 == other.0
    }
}

impl<T0, T1> Eq for (T0, T1) where T0: Eq, T1: Eq {
    fn eq(self, _ other: (T0, T1)) -> bool {
        self.0 == other.0 && self.1 == other.1
    }
}

impl<T0, T1, T2> Eq for (T0, T1, T2) where T0: Eq, T1: Eq, T2: Eq {
    fn eq(self, _ other: (T0, T1, T2)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2
    }
}

impl<T0, T1, T2, T3> Eq for (T0, T1, T2, T3) where T0: Eq, T1: Eq, T2: Eq, T3: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
    }
}

impl<T0, T1, T2, T3, T4> Eq for (T0, T1, T2, T3, T4) where T0: Eq, T1: Eq, T2: Eq, T3: Eq, T4: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3, T4)) -> bool {
        self.0 == other.0
            && self.1 == other.1
            && self.2 == other.2
            && self.3 == other.3
            && self.4 == other.4
    }
}

impl<T0, T1, T2, T3, T4, T5> Eq for (T0, T1, T2, T3, T4, T5)
where T0: Eq, T1: Eq, T2: Eq, T3: Eq, T4: Eq, T5: Eq {
    fn eq(self, _ other: (T0, T1, T2, T3, T4, T5)) -> bool {
        self.0 == other.0
            && self.1 == other.1
            && self.2 == other.2
            && self.3 == other.3
            && self.4 == other.4
            && self.5 == other.5
    }
}

pub trait Ord<T = Self> {
    fn lt(self, _ other: T) -> bool
    fn le(self, _ other: T) -> bool
    fn gt(self, _ other: T) -> bool
    fn ge(self, _ other: T) -> bool
}

/// A collection whose elements are places, as an array's are: `c[k]` names
/// the element at `k` with no call, a path that the access checker sees as
/// `c` indexed by a dynamic key, and `c[k].f = v` writes one field. A
/// collection implements it by saying where an element lives; the compiler
/// calls `locate` when it addresses the element.
pub trait PlaceIndex {
    /// The address space the elements live in, wherever the collection is.
    const SPACE: ingot::effect_ref::AddressSpace
    type Key: Copy
    type Output
    /// The codec of elements packed into lanes: an element is a lane of
    /// `Lanes::BITS` bits when `Lanes: LaneCodec<Output>` with `BITS` at most
    /// 128, and otherwise keeps its type's storage layout. `()` packs none.
    type Lanes = ()

    /// The slot holding the element at `key` of the collection whose place
    /// starts at slot `base`, and the element's byte offset within that slot.
    /// `width` is the element's size in storage: a lane's bytes, else 32
    /// bytes per slot the element's storage layout spans.
    fn locate(self, _ base: u256, _ key: Self::Key, _ width: u256) -> (u256, u256)
}

/// How a place-indexed collection encodes an element it packs into a lane:
/// `BITS` bits of a storage word, `offset` bytes above its low end, shared
/// with the neighbouring elements. Reading the element loads the word and
/// decodes it with `get`; writing it stores the word `set` returns, so only
/// the element's bits change.
pub trait LaneCodec<T> {
    const BITS: u256
    /// The element in `word`'s lane at `offset`.
    fn get(_ word: u256, offset: u256) -> T
    /// `word` with its lane at `offset` holding `value`.
    fn set(_ word: u256, offset: u256, value: own T) -> u256
}

/// `t[i]` where the context reads the element.
pub trait Index<I> {
    /// The effects of reaching an element.
    uses E
    /// The address space of the projected element.
    space S
    type Output

    fn index(self, _ index: I) -> ref Self::Output @S uses E
}

/// `t[i]` where the context needs a `mut` place: an assignment target,
/// `mut t[i]`, or a `mut self` method's receiver.
pub trait IndexMut<I>: Index<I> {
    /// The authority to mutate an element. It may strengthen `E` without
    /// widening what a read reaches.
    uses EM

    fn index_mut(mut self, _ index: I) -> mut Self::Output @S uses EM
}

// Augmented assignment operators (return unit)
pub trait AddAssign<T = Self> {
    fn add_assign(mut self, _ other: own T)
}

pub trait SubAssign<T = Self> {
    fn sub_assign(mut self, _ other: own T)
}

pub trait MulAssign<T = Self> {
    fn mul_assign(mut self, _ other: own T)
}

pub trait DivAssign<T = Self> {
    fn div_assign(mut self, _ other: own T)
}

pub trait RemAssign<T = Self> {
    fn rem_assign(mut self, _ other: own T)
}

pub trait PowAssign<T = Self> {
    fn pow_assign(mut self, _ other: own T)
}

pub trait ShlAssign<T = Self> {
    fn shl_assign(mut self, _ other: own T)
}

pub trait ShrAssign<T = Self> {
    fn shr_assign(mut self, _ other: own T)
}

pub trait BitAndAssign<T = Self> {
    fn bitand_assign(mut self, _ other: own T)
}

pub trait BitOrAssign<T = Self> {
    fn bitor_assign(mut self, _ other: own T)
}

pub trait BitXorAssign<T = Self> {
    fn bitxor_assign(mut self, _ other: own T)
}
