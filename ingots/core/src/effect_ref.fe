/// Effect reference traits.
///
/// Fe models effects as implicit "provider" generic parameters, and a
/// provider is a place. The `EffectRef<T>` marker traits express that a
/// provider type can satisfy a read-only (or mutable) effect whose domain is
/// `T`. A raw pointer's target, `*p`, is a place like any other.

/// A state space: the address spaces a `StateIndex` collection's elements
/// live in. Both start zeroed: a slot no one wrote reads as zero, so the
/// all-zero representation is a value of every type the space holds.
pub enum StateSpace {
    Storage,
    TransientStorage,
}

/// Marker: `Self` can satisfy a read-only effect whose domain is `Target`.
pub trait EffectRef<Target> {}

/// Marker: `Self` can satisfy a *mutable* effect whose domain is `Target`.
pub trait EffectRefMut<Target>: EffectRef<Target> {}

impl<T> EffectRef<T> for T {}
// Mutability is checked at the term level.
impl<T> EffectRefMut<T> for T {}
