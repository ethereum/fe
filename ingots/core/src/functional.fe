/// Core functional abstractions built around higher-kinded types.
///
/// This module defines:
/// - `Fn<T, U>`: a trait representing callable values.
/// - `Functor`: type constructors that can be mapped over.
/// - `Applicative`: type constructors that support `pure` and `<*>`.
/// - `Monad`: type constructors that support `bind`/`flat_map`.
///
/// These traits are designed for types of kind `* -> *`, such as `Option`
/// or partially applied types like `Result<E>`.

/// A callable value from `T` to `U`: `Fn(own T) -> U`.
pub trait Fn<T, U> {
    uses E

    fn call(self, _ value: own T) -> U uses E
}

// Callable shapes. `Fn(own A, B) -> R` and `FnMut(own A, B) -> R` name the
// trait of that shape, `Fn_ov<A, B, Out = R>`: the receiver's mode (`self`
// for `Fn`, `mut self` for `FnMut`) and each parameter's mode are part of
// the trait, since modes are not types, and the result is the associated
// `Out`, which the callable determines. `Fn(own T) -> U` is `Fn<T, U>`.
// `Fn` shapes are called with `call`, `FnMut` shapes with `call_mut`: method
// resolution never depends on a receiver's mode. Each shape's `uses E` is the
// row a closure fills with the effects it uses. Shapes have at most three
// parameters.

/// `Fn() -> Out`
pub trait Fn0 {
    uses E
    type Out

    fn call(self) -> Self::Out uses E
}

/// `Fn(A0) -> Out`
pub trait Fn_v<A0> {
    uses E
    type Out

    fn call(self, _ a0: A0) -> Self::Out uses E
}

/// `Fn(mut A0) -> Out`
pub trait Fn_m<A0> {
    uses E
    type Out

    fn call(self, _ a0: mut A0) -> Self::Out uses E
}

/// `Fn(own A0, own A1) -> Out`
pub trait Fn_oo<A0, A1> {
    uses E
    type Out

    fn call(self, _ a0: own A0, _ a1: own A1) -> Self::Out uses E
}

/// `Fn(own A0, A1) -> Out`
pub trait Fn_ov<A0, A1> {
    uses E
    type Out

    fn call(self, _ a0: own A0, _ a1: A1) -> Self::Out uses E
}

/// `Fn(own A0, mut A1) -> Out`
