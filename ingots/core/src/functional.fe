/// A type constructor that can be mapped over.
pub trait Functor
    where Self: * -> *
{
    fn map<T, U, F: Fn<T, U>>(self: own Self<T>, _ func: F) -> Self<U> uses F::E
}

/// A type constructor that supports `pure` and function application.
pub trait Applicative: Functor
    where Self: * -> *
{
    fn pure<T>(_ value: own T) -> Self<T>

    fn ap<T, U, F: Fn<T, U>>(self: own Self<F>, _ value: own Self<T>) -> Self<U> uses F::E
}

/// A monad in the sense of functional programming.
///
/// `bind` is also known as `flat_map` in some ecosystems.
pub trait Monad: Applicative
    where Self: * -> *
{
    fn bind<T, U, F: Fn<T, Self<U>>>(self: own Self<T>, _ func: F) -> Self<U> uses F::E
}
